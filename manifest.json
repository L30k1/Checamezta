{
  "manifest_version": 3,
  "name": "VeriSource AI",
  "version": "1.0.0",
  "description": "Analiza con IA la fiabilidad, el sesgo y el tono emocional de la página que estás leyendo.",
  "action": {
    "default_title": "Abrir VeriSource AI"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "activeTab", "scripting", "storage"],
  "host_permissions": ["https://api.anthropic.com/*", "<all_urls>"]
}
